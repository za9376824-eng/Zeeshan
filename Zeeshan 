<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Zeeshan Shopping Centre</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f5f6fa;
    color: #222;
}

header {
    background: #111827;
    color: white;
    padding: 20px;
    text-align: center;
}

header h1 {
    color: #facc15;
    font-size: 27px;
}

nav {
    background: #1f2937;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 12px;
}

.hero {
    background: linear-gradient(120deg,#111827,#2563eb);
    color: white;
    text-align: center;
    padding: 65px 15px;
}

.hero h2 {
    font-size: 35px;
    margin-bottom: 15px;
}

.hero button {
    padding: 12px 25px;
    background: #facc15;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 20px;
    font-weight: bold;
}

.search {
    display: block;
    width: 90%;
    max-width: 500px;
    margin: 25px auto;
    padding: 13px;
    border: 1px solid #ccc;
    border-radius: 8px;
}

.categories {
    text-align: center;
    padding: 15px;
}

.categories button {
    margin: 5px;
    padding: 10px 18px;
    border: none;
    background: #2563eb;
    color: white;
    border-radius: 5px;
    cursor: pointer;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit,minmax(210px,1fr));
    gap: 20px;
    padding: 25px;
}

.product {
    background: white;
    border-radius: 10px;
    overflow: hidden;
    box-shadow: 0 3px 12px #0001;
    text-align: center;
    padding-bottom: 18px;
}

.product img {
    width: 100%;
    height: 220px;
    object-fit: cover;
}

.product h3 {
    margin: 12px;
}

.price {
    color: #16a34a;
    font-size: 20px;
    font-weight: bold;
}

.product button {
    background: #2563eb;
    color: white;
    border: none;
    padding: 11px 20px;
    border-radius: 5px;
    margin-top: 12px;
    cursor: pointer;
}

.cart {
    background: white;
    padding: 25px;
    margin: 25px;
    border-radius: 10px;
}

.cart-item {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding: 12px 0;
    border-bottom: 1px solid #ddd;
    flex-wrap: wrap;
}

.cart-item button {
    padding: 5px 10px;
    cursor: pointer;
}

.checkout {
    background: #16a34a;
    color: white;
    border: none;
    padding: 14px 22px;
    border-radius: 6px;
    cursor: pointer;
    margin-top: 15px;
}

footer {
    background: #111827;
    color: white;
    text-align: center;
    padding: 25px;
    margin-top: 30px;
}

.whatsapp {
    background: #25d366;
    color: white;
    padding: 13px;
    border-radius: 50px;
    text-decoration: none;
    position: fixed;
    bottom: 20px;
    right: 15px;
}
</style>
</head>

<body>

<header>
    <h1>ZEESHAN SHOPPING CENTRE</h1>
    <p>Everything You Need, All in One Place!</p>
</header>

<nav>
    <a href="#home">Home</a>
    <a href="#products">Products</a>
    <a href="#cart">My Cart</a>
    <a href="#contact">Contact</a>
</nav>

<section class="hero" id="home">
    <h2>BIG SHOPPING SALE!</h2>
    <p>Shop Clothes for Kids, Men & Women</p>
    <button onclick="document.getElementById('products').scrollIntoView()">
        SHOP NOW
    </button>
</section>

<input
    class="search"
    id="search"
    type="text"
    placeholder="Search your product..."
    oninput="showProducts()"
>

<div class="categories">
    <button onclick="filterProducts('All')">All</button>
    <button onclick="filterProducts('Men')">Men</button>
    <button onclick="filterProducts('Women')">Women</button>
    <button onclick="filterProducts('Kids')">Kids</button>
</div>

<h2 style="text-align:center" id="products">Our Products</h2>

<div class="products" id="productList"></div>

<section class="cart" id="cart">
    <h2>🛒 Shopping Cart</h2>
    <div id="cartItems">Your cart is empty.</div>
    <h3 id="total">Total: Rs. 0</h3>
    <button class="checkout" onclick="checkout()">
        Order on WhatsApp
    </button>
</section>

<footer id="contact">
    <h2>Zeeshan Shopping Centre</h2>
    <p>Online Shopping Store</p>
    <p>Contact: 03000000000</p>
    <p>© 2026 All Rights Reserved</p>
</footer>

<a class="whatsapp"
   href="https://wa.me/923000000000"
   target="_blank">WhatsApp</a>

<script>
const products = [
 {
  id: 1,
  name: "Kids Tracksuit",
  category: "Kids",
  price: 1499,
  image: "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=500"
 },
 {
  id: 2,
  name: "Men Shirt",
  category: "Men",
  price: 1299,
  image: "https://images.unsplash.com/photo-1603252109303-2751441dd157?w=500"
 },
 {
  id: 3,
  name: "Women Dress",
  category: "Women",
  price: 2499,
  image: "https://images.unsplash.com/photo-1539008835657-9e8e9680c956?w=500"
 },
 {
  id: 4,
  name: "Girls Frock",
  category: "Kids",
  price: 1799,
  image: "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=500"
 },
 {
  id: 5,
  name: "Men Shalwar Kameez",
  category: "Men",
  price: 2299,
  image: "https://images.unsplash.com/photo-1598033129183-c4f50c736f10?w=500"
 },
 {
  id: 6,
  name: "Baby Dress",
  category: "Kids",
  price: 1199,
  image: "https://images.unsplash.com/photo-1519238263530-99bdd11df2ea?w=500"
 }
];

let cart = [];
let activeCategory = "All";

function showProducts() {
 const list = document.getElementById("productList");
 const search = document.getElementById("search").value.toLowerCase();

 const filtered = products.filter(p =>
   (activeCategory === "All" || p.category === activeCategory) &&
   p.name.toLowerCase().includes(search)
 );

 list.innerHTML = filtered.map(p => `
   <div class="product">
     <img src="${p.image}" alt="${p.name}">
     <h3>${p.name}</h3>
     <p class="price">Rs. ${p.price.toLocaleString("en-PK")}</p>
     <button onclick="addToCart(${p.id})">
       Add to Cart
     </button>
   </div>
 `).join("");
}

function filterProducts(category) {
 activeCategory = category;
 showProducts();
}

function addToCart(id) {
 const product = products.find(p => p.id === id);
 const existing = cart.find(p => p.id === id);

 if(existing) {
   existing.qty++;
 } else {
   cart.push({...product, qty: 1});
 }

 showCart();
}

function changeQty(id, amount) {
 const item = cart.find(p => p.id === id);
 if(!item) return;

 item.qty += amount;

 if(item.qty <= 0) {
   cart = cart.filter(p => p.id !== id);
 }

 showCart();
}

function showCart() {
 const area = document.getElementById("cartItems");

 if(cart.length === 0) {
   area.innerHTML = "Your cart is empty.";
 } else {
   area.innerHTML = cart.map(item => `
     <div class="cart-item">
       <span>${item.name}</span>
       <span>
         <button onclick="changeQty(${item.id},-1)">-</button>
         ${item.qty}
         <button onclick="changeQty(${item.id},1)">+</button>
       </span>
       <strong>Rs. ${(item.price * item.qty).toLocaleString("en-PK")}</strong>
     </div>
   `).join("");
 }

 const total = cart.reduce(
   (sum,item) => sum + item.price * item.qty, 0
 );

 document.getElementById("total").innerText =
   "Total: Rs. " + total.toLocaleString("en-PK");
}

function checkout() {
 if(cart.length === 0) {
   alert("Please add products to your cart first!");
   return;
 }

 const total = cart.reduce(
   (sum,item) => sum + item.price * item.qty, 0
 );

 let message = "Assalam o Alaikum! I want to order:\n\n";

 cart.forEach(item => {
   message += item.name + " x " + item.qty +
   " = Rs. " + (item.price * item.qty) + "\n";
 });

 message += "\nTotal: Rs. " + total;
 message += "\nPlease confirm my order.";

 const phone = "923000000000";

 window.open(
   "https://wa.me/" + phone + "?text=" +
   encodeURIComponent(message),
   "_blank"
 );
}

showProducts();
showCart();
</script>

</body>
</html>